# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Excel workbooks (binary; not tracked by default)
*.xlsx
# Ground-truth and source workbooks under 2023 einzel/paare (not under exports/)
!data/2023/einzel/**/*.xlsx
!data/2023/paare/**/*.xlsx
data/2023/einzel/exports/**/*.xlsx
data/2023/paare/exports/**/*.xlsx

# data/2023: session state, exports, backups — not versioned (Excel exceptions above)
data/2023/**/*.csv
data/2023/**/*.json
data/2023/**/*.json.bak

# example/: cannot use `example/` + `!.../file` — ignored parent dirs block re-include (gitignore(5)).
example/*
!example/stundenlauf-2025.stundenlauf-season/
example/stundenlauf-2025.stundenlauf-season/*
!example/stundenlauf-2025.stundenlauf-season/*.json

# Inno Setup output (local builds)
installer/output/

# Node.js / TypeScript port
node_modules/
packages/stundenlauf-ts/dist/
packages/stundenlauf-ts/coverage/
*.tsbuildinfo